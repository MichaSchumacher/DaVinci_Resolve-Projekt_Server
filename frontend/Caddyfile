# Globale Optionen
{
	servers {
		# Welchen vorgeschalteten Proxys Caddy die Absender-IP (X-Forwarded-For) glaubt.
		# Standard: niemandem. Im NPM-Modus (docker-compose.npm.yml): private Netze.
		trusted_proxies static {$TRUSTED_PROXIES:127.0.0.1/32}
		# Von rechts lesen: eine vom Browser gefälschte X-Forwarded-For wird ignoriert.
		trusted_proxies_strict
	}
}

# Gemeinsame Konfiguration beider Zugänge
(webui) {
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self'; script-src 'self'; frame-ancestors 'none'"
		-Server
	}

	# Nur das Frontend spricht mit dem Backend – das Backend hat keinen eigenen Port.
	handle /api/* {
		reverse_proxy backend:8000 {
			# Echte Besucher-IP fürs Backend (u. a. Sperre nach Fehlanmeldungen)
			header_up X-RPS-Client-IP {client_ip}
		}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

# 1) Über die Domain aus dem Internet – Caddy holt automatisch ein HTTPS-Zertifikat.
{$DOMAIN} {
	import webui
	header Strict-Transport-Security "max-age=31536000"
}

# 2) Port 8543, unverschlüsselt – wie das Admin-Panel des WireBear Studio Servers.
#    Für den Zugriff im lokalen Netz und als Ziel für einen Reverse Proxy (NPM).
#    Diesen Port NIE am Router weiterleiten.
http://:8543 {
	import webui
}
