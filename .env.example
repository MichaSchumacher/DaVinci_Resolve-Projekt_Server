# ---------------------------------------------------------------
# Resolve Project Server - Konfiguration
# Kopieren nach .env und alle Werte anpassen.
#
# Bitte nur ASCII-Zeichen verwenden: keine Umlaute (ae, oe, ue statt der Umlaute),
# kein Eszett (ss schreiben) und in Passwoertern nur A-Z a-z 0-9 sowie - _ .
# (Zeichen wie $ # " ' Leerzeichen koennen .env und Docker durcheinanderbringen.)
# ---------------------------------------------------------------

# Absoluter Pfad auf dem HOST fuer alle Daten (Datenbanken, Sicherungen, Einstellungen)
DATA_DIR=/opt/resolve-project-server/data

# Domain der Web-UI (DNS-A-Record muss auf deine oeffentliche IP zeigen).
# Zum lokalen Testen ohne Domain: DOMAIN=:80
DOMAIN=resolve.example.com

# Adresse, die Resolve-Clients zum Verbinden nutzen (meist dieselbe Domain oder deine feste IP).
# Laesst sich spaeter in der Web-UI aendern.
PUBLIC_HOST=resolve.example.com

# Erste Anmeldung an der Web-UI (danach unter "Konto" aenderbar)
ADMIN_USER=admin
ADMIN_PASSWORD=bitte-ein-langes-zufaelliges-passwort

# PostgreSQL-Zugang, den Resolve verwendet.
# Resolve nutzt standardmaessig postgres / DaVinci - fuer den Betrieb im Internet
# UNBEDINGT ein starkes Passwort setzen!
POSTGRES_USER=postgres
POSTGRES_PASSWORD=bitte-ein-starkes-datenbankpasswort

# Startversion (danach per Web-UI wechselbar). Resolve 18-20: 13
PG_VERSION=13

# Port, unter dem PostgreSQL nach aussen erreichbar ist.
# Resolve erwartet 5432 - nur aendern, wenn du weisst, was du tust.
PG_PUBLIC_PORT=5432
# 0.0.0.0 = aus dem Internet erreichbar; z. B. 100.x.y.z = nur ueber Tailscale
PG_BIND_ADDRESS=0.0.0.0

# Passwortverfahren fuer neue Datenverzeichnisse: md5 (hoechste Kompatibilitaet) oder scram-sha-256
PG_AUTH_METHOD=md5

# Web-UI zusaetzlich unverschluesselt auf Port 8543 (lokales Netz / Ziel fuer NPM).
# 127.0.0.1 = nur auf diesem Rechner, 0.0.0.0 = im ganzen LAN.
# Diesen Port NIE am Router weiterleiten!
ADMIN_PORT_BIND=0.0.0.0

# --- Betrieb hinter Nginx Proxy Manager (NPM) -------------------------------
# NPM uebernimmt HTTPS, Caddy oeffnet dann kein 80/443 mehr. Zum Aktivieren
# die passende Zeile einkommentieren (Details im README unter "Hinter NPM"):
#
# NPM auf einem anderen Rechner:
#COMPOSE_FILE=docker-compose.yml:docker-compose.npm.yml
#
# NPM auf demselben Docker-Host (gemeinsames Docker-Netz):
#COMPOSE_FILE=docker-compose.yml:docker-compose.npm.yml:docker-compose.npm-network.yml
#NPM_NETWORK=npm_default

TZ=Europe/Berlin
