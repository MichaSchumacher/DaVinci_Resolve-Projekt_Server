# ---------------------------------------------------------------
# Resolve Project Server – Konfiguration
# Kopieren nach .env und alle Werte anpassen.
# ---------------------------------------------------------------

# Absoluter Pfad auf dem HOST für alle Daten (Datenbanken, Sicherungen, Einstellungen)
DATA_DIR=/opt/resolve-project-server/data

# Domain der Web-UI (DNS-A-Record muss auf deine öffentliche IP zeigen).
# Zum lokalen Testen ohne Domain: DOMAIN=:80
DOMAIN=resolve.example.com

# Adresse, die Resolve-Clients zum Verbinden nutzen (meist dieselbe Domain oder deine feste IP).
# Lässt sich später in der Web-UI ändern.
PUBLIC_HOST=resolve.example.com

# Erste Anmeldung an der Web-UI (danach unter „Konto“ änderbar)
ADMIN_USER=admin
ADMIN_PASSWORD=bitte-ein-langes-zufaelliges-passwort

# PostgreSQL-Zugang, den Resolve verwendet.
# Resolve nutzt standardmäßig postgres / DaVinci – für den Betrieb im Internet
# UNBEDINGT ein starkes Passwort setzen!
POSTGRES_USER=postgres
POSTGRES_PASSWORD=bitte-ein-starkes-datenbankpasswort

# Startversion (danach per Web-UI wechselbar). Resolve 18–20: 13
PG_VERSION=13

# Port, unter dem PostgreSQL nach außen erreichbar ist.
# Resolve erwartet 5432 – nur ändern, wenn du weißt, was du tust.
PG_PUBLIC_PORT=5432
# 0.0.0.0 = aus dem Internet erreichbar; z. B. 100.x.y.z = nur über Tailscale
PG_BIND_ADDRESS=0.0.0.0

# Passwortverfahren für neue Datenverzeichnisse: md5 (höchste Kompatibilität) oder scram-sha-256
PG_AUTH_METHOD=md5

# Web-UI zusätzlich unverschlüsselt auf Port 8543 im lokalen Netz.
# 127.0.0.1 = nur auf diesem Rechner, 0.0.0.0 = im ganzen LAN. Nicht am Router freigeben!
ADMIN_PORT_BIND=0.0.0.0

TZ=Europe/Berlin
